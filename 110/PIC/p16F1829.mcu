<!DOCTYPE SimulIDE>

<mcu name="p16F1829" core="Pic14e" data="4096" prog="8192" progword="2" eeprom="256" 
            inst_cycle="4" freq="32000000">
            
    <include file="pic/pic14e_regs.xml" />
    <include file="p16F182x/p16F1829_regs.xml" />

    <include file="p16F182x/p16F1829_int.xml" />
    <include file="p16F182x/p16F1828_perif.xml" />

    <msspunit name="MSSP2" type="00" configregsA="SSP2CON1" >
                        
      <twi name="TWI"  configregsA="SSP2CON1" configregsB="SSP2CON2" 
                       dataregs="SSP2BUF" 
                       addressreg="SSP2ADD"
                       statusreg="SSP2STAT" 
                       interrupt="SSP2"
                       prescalers=""
                       pins="PORTB5,PORTB7" /><!-- "SDA,SCL" -->

      <spi name="SPI"  configregsA="SSP2CON1" 
                       dataregs="SSP2BUF" 
                       statusreg="SSP2STAT"
                       interrupt="SSP2" 
                       prescalers="4,16,64,0"
                       pins="PORTC1,PORTB5,PORTB7,PORTC0"/><!-- "SD0,SDI,SCK,SS" -->
    </msspunit>

</mcu>
