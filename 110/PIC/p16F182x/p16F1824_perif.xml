<parts>

  <port name="PORTA" pins="6" outreg="PORTA,LATA" dirreg="!TRISA"
                     configregsA="ANSELA"
                     inpmask="00110111"
                     pullups="WPUA"
                     resetpin="PORTA3">
    <extint    name="INT" pin="PORTA2" configbits="INTEDG"/>
    <interrupt name="IOC" mask="00111111"/>
  </port>

  <port name="PORTC" pins="6" outreg="PORTC,LATC" dirreg="!TRISC"
                     configregsA="ANSELC"
                     inpmask="00111111"
                     pullups="WPUC" />

  <intosc name="intosc" type="02" configregsA="OSCCON" 
                        clockpins="PORTA4,PORTA5" />

  <timer name="TIMER0" type="800" configregsA="OPTION" 
                       counter="TMR0"
                       clockpin="PORTA2"
                       interrupt="T0_OVF"
                       prescalers="2,4,8,16,32,64,128,256"/>

  <timer name="TIMER1" type="161" configregsA="T1CON" 
                       counter="TMR1L,TMR1H"
                       clockpin="PORTA5"
                       interrupt="T1_OVF"
                       prescalers="1,2,4,8"/>

  <timer name="TIMER2" type="820" configregsA="T2CON" configregsB="PR2"
                       counter="TMR2"
                       interrupt="T2_MATCH"
                       prescalers="1,4,16,64"/>

  <timer name="TIMER4" type="820" configregsA="T4CON" configregsB="PR4"
                       counter="TMR4"
                       interrupt="T4_MATCH"
                       prescalers="1,4,16,64"/>

  <timer name="TIMER6" type="820" configregsA="T6CON" configregsB="PR6"
                       counter="TMR6"
                       interrupt="T6_MATCH"
                       prescalers="1,4,16,64"/>

  <ccpunit name="CCP+1" type="00" configregsA="CCP1CON"
                        ccpreg="CCPR1L,CCPR1H"
                        pin="PORTC5"
                        interrupt="CCP1" />

  <ccpunit name="CCP+2" type="00" configregsA="CCP2CON"
                        ccpreg="CCPR2L,CCPR2H"
                        pin="PORTA5"
                        interrupt="CCP2" />

  <ccpunit name="CCP3"  type="00" configregsA="CCP3CON"
                        ccpreg="CCPR3L,CCPR3H"
                        pin="PORTA2"
                        interrupt="CCP3" />

  <ccpunit name="CCP4"  type="00" configregsA="CCP4CON"
                        ccpreg="CCPR4L,CCPR4H"
                        pin="PORTC1"
                        interrupt="CCP4" />

  <usart name="EUSART"  number="1" configregsA="TXSTA" configregsB="RCSTA" configregsC="BAUDCON"
                        interrupt="USART_T">

      <trunit type="tx" pin="PORTC4,PORTA0" configbitsA="TXCKSEL" register="TXREG"/>
      <trunit type="rx" pin="PORTC5,PORTA1" configbitsA="RXDTSEL" register="RCREG" interrupt="USART_R" />
  </usart>

  <msspunit name="MSSP1" type="00" configregsA="SSP1CON1" >
                      
    <twi name="TWI"  configregsA="SSP1CON1" configregsB="SSP1CON2" 
                     dataregs="SSP1BUF" 
                     addressreg="SSP1ADD"
                     statusreg="SSP1STAT" 
                     interrupt="SSP1"
                     prescalers=""
                     pins="PORTC1,PORTC0" /><!-- "SDA,SCL" -->

    <spi name="SPI"  configregsA="SSP1CON1" 
                     dataregs="SSP1BUF" 
                     statusreg="SSP1STAT"
                     interrupt="SSP1" 
                     prescalers="4,16,64,0"
                     pins="PORTC2,PORTC1,PORTC0,PORTC3"/><!-- "SD0,SDI,SCK,SS" -->
  </msspunit>

  <vref name="Vref" configregsA="FVRCON" />

  <adc name="ADC" type="20" bits="10" configregsA="ADCON0" configregsB="ADCON1"
                  dataregs="ADRESL,ADRESH"
                  interrupt="ADC"
                  prescalers="2,8,32,0,4,16,64,0"
                  adcpins="PORTA0,PORTA1,PORTA2,PORTA4,PORTC0,PORTC1,PORTC2,PORTC3"
                  vrefpins="PORTA1,PORTA0"/>

  <dac name="DAC" configregsA="DACCON0"
                  dacreg="DACCON1"
                  pins="PORTA0" />

  <comp name="COMP1" type="20" configregsA="CM1CON0" configregsB="CM1CON1"
                     interrupt="COMP1"
                     pins="PORTA0,PORTA1,PORTA2" />

  <comp name="COMP2" type="20" configregsA="CM2CON0" configregsB="CM2CON1"
                     interrupt="COMP2"
                     pins="PORTC0,PORTC1,PORTC4" />

  <wdt name="WDT" type="01" configregsA="WDTCON"
                  prescalers="1,2,4,8,16,32,64,128"/>

  <rom name="ROM" configregsA="EECON1" configregsB="EECON2"
                  dataregs="EEDATL" 
                  addressreg="EEADRL" 
                  interrupt="EEPR" />

  <configwords name="cfgWord" type="04">
    <word name="CONFIG1" address="0x8007" value="0x09C4" />
    <word name="CONFIG2" address="0x8008" value="0x1EFF" />
  </configwords>

</parts>
